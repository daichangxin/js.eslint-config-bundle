{
    "name": "@eds-open/eslint-config-bundle",
    "version": "2.6.0",
    "description": "",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "files": [
        "dist/"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./js": {
            "types": "./dist/js.config.d.ts",
            "default": "./dist/js.config.js"
        },
        "./typescript": {
            "types": "./dist/typescript.config.d.ts",
            "default": "./dist/typescript.config.js"
        },
        "./react": {
            "types": "./dist/react.config.d.ts",
            "default": "./dist/react.config.js"
        },
        "./imports": {
            "types": "./dist/imports.config.d.ts",
            "default": "./dist/imports.config.js"
        },
        "./unused": {
            "types": "./dist/unused.config.d.ts",
            "default": "./dist/unused.config.js"
        },
        "./tailwindcss": {
            "types": "./dist/tailwindcss.config.d.ts",
            "default": "./dist/tailwindcss.config.js"
        },
        "./prettier": {
            "types": "./dist/prettier.config.d.ts",
            "default": "./dist/prettier.config.js"
        }
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "test": "echo \"Error: no test specified\""
    },
    "keywords": [
        "eslint",
        "eslint-config"
    ],
    "author": "daichangxin",
    "license": "MIT",
    "dependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.2",
        "@stylistic/eslint-plugin": "^5.6.1",
        "eslint": "^9.39.2",
        "eslint-plugin-antfu": "^3.1.1",
        "eslint-plugin-import-x": "^4.16.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-hooks-addons": "^0.5.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-tailwindcss": "^3.18.2",
        "eslint-plugin-unused-imports": "^4.3.0",
        "globals": "^17.0.0",
        "typescript-eslint": "^8.52.0"
    },
    "devDependencies": {
        "@types/eslint": "^9.6.1",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/eslint-plugin-tailwindcss": "^3.17.0",
        "@types/node": "^25.0.3",
        "@types/react": "^19.2.7",
        "react": "^19.2.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^4.5.4"
    }
}
